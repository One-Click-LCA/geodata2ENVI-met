                        <double>10000.000000000000000</double>
                       </property>
                       <property name="value">
                        <double>10.000000000000000</double>
                       </property>
                      </widget>
                     </item>
                     <item row="1" column="0">
                      <widget class="QLabel" name="label_126">
                       <property name="text">
                        <string>Particle density (g/cm³):</string>
                       </property>
                      </widget>
                     </item>
                     <item row="1" column="1">
                      <widget class="QDoubleSpinBox" name="sb_particleDens">
                       <property name="locale">
                        <locale language="English" country="UnitedStates"/>
                       </property>
                       <property name="maximum">
                        <double>10000.000000000000000</double>
                       </property>
                       <property name="value">
                        <double>1.000000000000000</double>
                       </property>
                      </widget>
                     </item>
                    </layout>
                   </widget>
                  </item>
                 </layout>
                </widget>
               </item>
              </layout>
             </widget>
             <widget class="QWidget" name="tab_Radiation">
              <attribute name="title">
               <string>Radiation Settings</string>
              </attribute>
              <layout class="QGridLayout" name="gridLayout_82">
               <item row="0" column="0" colspan="2">
                <widget class="QGroupBox" name="gb_IVS">
                 <property name="title">
                  <string>Indexed View Sphere (IVS)</string>
                 </property>
                 <layout class="QGridLayout" name="gridLayout_44">
                  <item row="1" column="0">
                   <widget class="QLabel" name="label_97">
                    <property name="text">
                     <string>Resolution for height segment angles:</string>
                    </property>
                   </widget>
                  </item>
                  <item row="1" column="1">
                   <widget class="QComboBox" name="cb_resIVS">
                    <property name="currentIndex">
                     <number>1</number>
                    </property>
                    <item>
                     <property name="text">
                      <string>Off</string>
                     </property>
                    </item>
                    <item>
                     <property name="text">
                      <string>Lowest (45°)</string>
                     </property>
                    </item>
                    <item>
                     <property name="text">
                      <string>Low (30°)</string>
                     </property>
                    </item>
                    <item>
                     <property name="text">
                      <string>Medium (15°)</string>
                     </property>
                    </item>
                    <item>
                     <property name="text">
                      <string>High (10°)</string>
                     </property>
                    </item>
                    <item>
                     <property name="text">
                      <string>Very High (5°)</string>
                     </property>
                    </item>
                    <item>
                     <property name="text">
                      <string>Ultra High (2°)</string>
                     </property>
                    </item>
                   </widget>
                  </item>
                 </layout>
                </widget>
               </item>
               <item row="2" column="1">
                <spacer name="verticalSpacer_14">
                 <property name="orientation">
                  <enum>Qt::Vertical</enum>
                 </property>
                 <property name="sizeHint" stdset="0">
                  <size>
                   <width>20</width>
                   <height>40</height>
                  </size>
                 </property>
                </spacer>
               </item>
               <item row="1" column="0" colspan="2">
                <widget class="QLabel" name="label_99">
                 <property name="text">
                  <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;The Indexed View Sphere (IVS) algorithm enables a higher level of detail regarding the calculation of reflected shortwave and longwave radiation fluxes by taking into account multiple&lt;/p&gt;&lt;p&gt;interactions between objects (vegetation, buildings, surfaces). Segment angle sizes refer to the number of segments to be calculated for each view sphere. As angle values decrease,&lt;/p&gt;&lt;p&gt;accuracy of received radiation as well as number of segments increase. The higher level of detail massively increases RAM demand.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                 </property>
                </widget>
               </item>
              </layout>
             </widget>
             <widget class="QWidget" name="tab_Output">
              <attribute name="title">
               <string>Output Settings</string>
              </attribute>
              <layout class="QGridLayout" name="gridLayout_98">
               <item row="0" column="0">
                <widget class="QGroupBox" name="gb_outputFiles">
                 <property name="title">
                  <string>Output Files</string>
                 </property>
                 <layout class="QGridLayout" name="gridLayout_34">
                  <item row="0" column="0">
                   <widget class="QCheckBox" name="cb_outputBldData">
                    <property name="text">
                     <string>Building Data (Facade Temperature, Roof Temperature, etc.)</string>
                    </property>
                    <property name="checked">
                     <bool>true</bool>
                    </property>
                   </widget>
                  </item>
                  <item row="3" column="0">
                   <widget class="QCheckBox" name="cb_outputVegData">
                    <property name="text">
                     <string>Vegetation Data (Leaf Temperature, Transpiration Flux, etc.)</string>
                    </property>
                    <property name="checked">
                     <bool>true</bool>
                    </property>
                   </widget>
                  </item>
                  <item row="1" column="0">
                   <widget class="QCheckBox" name="cb_outputRadData">
                    <property name="text">
