                     <size>
                      <width>20</width>
                      <height>40</height>
                     </size>
                    </property>
                   </spacer>
                  </item>
                  <item row="0" column="3">
                   <widget class="QSpinBox" name="sb_outputIntRecBld">
                    <property name="minimum">
                     <number>1</number>
                    </property>
                    <property name="maximum">
                     <number>100000</number>
                    </property>
                    <property name="value">
                     <number>30</number>
                    </property>
                   </widget>
                  </item>
                  <item row="4" column="0">
                   <widget class="QLabel" name="label_145">
                    <property name="text">
                     <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Decide which output files should be saved. Please be aware, that by &lt;/p&gt;&lt;p&gt;de-selecting outputs, these will not be saved in the simulation.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                    </property>
                   </widget>
                  </item>
                  <item row="2" column="0">
                   <widget class="QCheckBox" name="cb_outputSoilData">
                    <property name="text">
                     <string>Soil Data (Soil Wetness, Soil Temperature, etc.)</string>
                    </property>
                    <property name="checked">
                     <bool>true</bool>
                    </property>
                   </widget>
                  </item>
                  <item row="4" column="2" colspan="2">
                   <widget class="QLabel" name="label_148">
                    <property name="text">
                     <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Decide in which output interval you want to save the receptor &lt;/p&gt;&lt;p&gt;and building data and all other files.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                    </property>
                   </widget>
                  </item>
                  <item row="1" column="2">
                   <widget class="QLabel" name="label_147">
                    <property name="text">
                     <string>Output Interval: All other files [min]:</string>
                    </property>
                   </widget>
                  </item>
                  <item row="1" column="3">
                   <widget class="QSpinBox" name="sb_outputIntOther">
                    <property name="minimum">
                     <number>1</number>
                    </property>
                    <property name="maximum">
                     <number>100000</number>
                    </property>
                    <property name="value">
                     <number>60</number>
                    </property>
                   </widget>
                  </item>
                  <item row="0" column="2">
                   <widget class="QLabel" name="label_146">
                    <property name="text">
                     <string>Output Interval: Receptors and buildings [min]:</string>
                    </property>
                   </widget>
                  </item>
                 </layout>
                </widget>
               </item>
               <item row="1" column="0">
                <widget class="QGroupBox" name="gb_netCDFoutput">
                 <property name="title">
                  <string>NetCDF Output Files</string>
                 </property>
                 <layout class="QGridLayout" name="gridLayout_35">
                  <item row="0" column="0">
                   <layout class="QVBoxLayout" name="verticalLayout_13">
                    <item>
                     <widget class="QGroupBox" name="gb_writeNetCDF">
                      <property name="title">
                       <string>Write supplementary NetCDF output</string>
                      </property>
                      <layout class="QGridLayout" name="gridLayout_102">
                       <item row="0" column="0">
                        <widget class="QRadioButton" name="rb_writeNetCDFyes">
                         <property name="sizePolicy">
                          <sizepolicy hsizetype="Minimum" vsizetype="Preferred">
                           <horstretch>0</horstretch>
                           <verstretch>0</verstretch>
                          </sizepolicy>
                         </property>
                         <property name="text">
                          <string>Yes</string>
                         </property>
                        </widget>
                       </item>
                       <item row="0" column="1">
                        <widget class="QRadioButton" name="rb_writeNetCDFNo">
                         <property name="text">
                          <string>No</string>
                         </property>
                         <property name="checked">
                          <bool>true</bool>
                         </property>
                        </widget>
                       </item>
                      </layout>
                     </widget>
                    </item>
                    <item>
                     <widget class="QLabel" name="label_149">
                      <property name="text">
                       <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Check if NetCDF files shall be written additional to the ENVI-met default outputs. All ENVI-met output variables (out of the folders atmosphere, buildings, &lt;/p&gt;&lt;p&gt;radiation, etc.) will be stored in one file (unless the small file option is selected at the bottom of this NetCDF settings section). &lt;/p&gt;&lt;p&gt;NetCDF is a universal file format for multidimensional datasets, commonly used for climate models. Multiple libraries and software packages allow a &lt;/p&gt;&lt;p&gt;broad range of independent analysis possibilities.&lt;/p&gt;&lt;p&gt;Please install the netCDF-C library &amp;quot;netCDF-4 64-bit (Windows)&amp;quot; to enable NetCDF file writing (download can be found on the official netCDF Website:&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://downloads.unidata.ucar.edu/netcdf/&quot;&gt;&lt;span style=&quot; text-decoration: underline; color:#0000ff;&quot;&gt;https://downloads.unidata.ucar.edu/netcdf/&lt;/span&gt;&lt;/a&gt;)&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                      </property>
                     </widget>
                    </item>
                    <item>
                     <layout class="QHBoxLayout" name="horizontalLayout_13"/>
                    </item>
                   </layout>
                  </item>
                 </layout>
                </widget>
               </item>
               <item row="2" column="0">
                <spacer name="verticalSpacer_11">
                 <property name="orientation">
                  <enum>Qt::Vertical</enum>
                 </property>
                 <property name="sizeHint" stdset="0">
                  <size>
                   <width>20</width>
                   <height>40</height>
                  </size>
                 </property>
                </spacer>
               </item>
              </layout>
             </widget>
             <widget class="QWidget" name="tab_Expert">
              <attribute name="title">
               <string>Expert Settings</string>
              </attribute>
              <layout class="QGridLayout" name="gridLayout_103">
               <item row="1" column="0">
                <widget class="QGroupBox" name="gb_simThreading">
                 <property name="title">
                  <string>Simulation Threading</string>
                 </property>
                 <layout class="QGridLayout" name="gridLayout_108">
                  <item row="1" column="0" colspan="2">
                   <widget class="QLabel" name="label_153">
                    <property name="text">
                     <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;When running in its own thread, the application will stay responsive. &lt;br/&gt;However, multiple simulations on the same PC might cause instabilities &lt;br/&gt;and detailed error messages are not supported.&lt;/p&gt;&lt;p&gt;&lt;br/&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                    </property>
                   </widget>
                  </item>
                  <item row="0" column="0" colspan="2">
                   <widget class="QGroupBox" name="gb_threading">
                    <property name="title">
                     <string>Threading</string>
                    </property>
                    <layout class="QGridLayout" name="gridLayout_109">
                     <item row="0" column="0">
                      <widget class="QRadioButton" name="rb_threadingMain">
                       <property name="text">
                        <string>Run simulation in main thread</string>
                       </property>
                       <property name="checked">
                        <bool>true</bool>
                       </property>
                      </widget>
                     </item>
                     <item row="1" column="0">
                      <widget class="QRadioButton" name="rb_threadingOwn">
                       <property name="text">
                        <string>Run simulation in its own thread</string>
                       </property>
                      </widget>
                     </item>
                    </layout>
                   </widget>
                  </item>
                 </layout>
                </widget>
               </item>
              </layout>
             </widget>
            </widget>
           </item>
          </layout>
         </widget>
         <widget class="QWidget" name="tab_startSim">
          <attribute name="title">
           <string>Start ENVI-met simulation</string>
          </attribute>
          <layout class="QGridLayout" name="gridLayout_69">
           <item row="0" column="0">
            <widget class="QGroupBox" name="gb_info_startSim">
             <property name="title">
              <string>Information for ENVI-met simulations</string>
             </property>
             <layout class="QGridLayout" name="gridLayout_27">
              <item row="0" column="0">
               <widget class="QLabel" name="label_157">
                <property name="text">
                 <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;An ENVI-met simulation needs a project-folder inside your ENVI-met workspace. The simulation-file (*.SIMX) and your model area (*.INX) &lt;/p&gt;&lt;p&gt;need to be located in this project-folder. The model area - file (*.INX) needs to be next to your simulation-file (*.SIMX).&lt;/p&gt;&lt;p&gt;&lt;br/&gt;&lt;/p&gt;&lt;p&gt;To start an ENVI-simulation via QGIS, select the project-folder and the simulation-file (*.SIMX). Then, click &amp;quot;Start Simulation&amp;quot;. The simulation starts in an &lt;/p&gt;&lt;p&gt;command-prompt and runs independently from QGIS. You can close QGIS or continue your work with QGIS and the simulation will keep running. &lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                </property>
               </widget>
              </item>
             </layout>
            </widget>
           </item>
           <item row="1" column="0">
            <widget class="QGroupBox" name="gb_runSim">
             <property name="title">
              <string>Start simulation:</string>
             </property>
             <layout class="QGridLayout" name="gridLayout_28">
              <item row="0" column="0" colspan="5">
               <widget class="QLabel" name="lb_infoRunSim">
                <property name="text">
                 <string>Select a simulation-file (*.SIMX) and a project-folder to start the simulation.</string>
                </property>
               </widget>
              </item>
              <item row="1" column="0">
               <widget class="QPushButton" name="bt_selectProj">
                <property name="text">
                 <string>Select Project-folder</string>
                </property>
               </widget>
              </item>
              <item row="1" column="1">
               <widget class="QPushButton" name="bt_selectSIMX">
                <property name="text">
                 <string>Select SIMX-file</string>
                </property>
               </widget>
              </item>
              <item row="2" column="0">
               <widget class="QLabel" name="lb_selected_proj">
                <property name="text">
                 <string>Selected Project-folder:</string>
                </property>
               </widget>
              </item>
              <item row="2" column="1" colspan="4">
               <widget class="QLabel" name="lb_selected_projFolder">
                <property name="text">
                 <string>None</string>
                </property>
               </widget>
              </item>
              <item row="3" column="0">
               <widget class="QLabel" name="lb_selSimx">
                <property name="text">
                 <string>Selected Simulation-file (*.SIMX):</string>
                </property>
               </widget>
              </item>
              <item row="3" column="1" colspan="4">
               <widget class="QLabel" name="lb_simxFile">
                <property name="text">
                 <string>None</string>
                </property>
               </widget>
              </item>
              <item row="4" column="2">
               <widget class="QPushButton" name="bt_startSim">
                <property name="text">
                 <string>Start Simulation</string>
                </property>
               </widget>
              </item>
             </layout>
            </widget>
